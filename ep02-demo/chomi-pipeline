#!/bin/bash
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🔀 EP02 Pipeline Wrapper — Enhanced chomi-pipeline                        ║
# ║  Integrates with Naledi's demo layer                                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

# Colors
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'; BOLD='\033[1m'

# Configuration
NAME="${1:-default}"
STEPS="${2:-step1,step2,step3}"
AUTO_APPROVE="${AUTO_APPROVE:-false}"

IFS=',' read -ra STEP_ARRAY <<< "$STEPS"

echo -e "${BLUE}${BOLD}"
echo "═══════════════════════════════════════════════════════════════"
echo "  🦞 Chomi Pipeline: $NAME"
echo "═══════════════════════════════════════════════════════════════"
echo -e "${NC}"

TOTAL=${#STEP_ARRAY[@]}
PASSED=0
SKIPPED=0
FAILED=0

for i in "${!STEP_ARRAY[@]}"; do
    STEP="${STEP_ARRAY[$i]}"
    NUM=$((i+1))
    
    echo ""
    echo -e "${CYAN}┌─────────────────────────────────────────┐${NC}"
    echo -e "${CYAN}│  STEP ${NUM}/${TOTAL}: ${BOLD}${STEP}${NC}"
    echo -e "${CYAN}└─────────────────────────────────────────┘${NC}"
    
    # Approval gate
    if [ "$AUTO_APPROVE" = "true" ]; then
        echo -e "${GREEN}✓ Auto-approved${NC}"
        RESPONSE="y"
    else
        echo -e "${YELLOW}🤔 Approve this step? [Y/n/skip]${NC}"
        read -r -t 30 RESPONSE || RESPONSE="y"
    fi
    
    case "${RESPONSE,,}" in
        n|no)
            echo -e "${RED}❌ Step rejected. Stopping pipeline.${NC}"
            FAILED=$((FAILED + 1))
            
            # Summary
            echo ""
            echo -e "${RED}${BOLD}Pipeline aborted.${NC}"
            echo -e "  Steps passed: $PASSED"
            echo -e "  Steps skipped: $SKIPPED"
            echo -e "  Steps failed: $FAILED"
            exit 1
            ;;
        skip|s)
            echo -e "${YELLOW}⏭️ Step skipped.${NC}"
            SKIPPED=$((SKIPPED + 1))
            continue
            ;;
        *)
            echo -e "${GREEN}✓ Approved. Executing...${NC}"
            ;;
    esac
    
    # Execute step
    echo -e "${CYAN}🚀 Executing ${STEP}...${NC}"
    
    # Simulate work with realistic output
    case "$STEP" in
        "setup"|"configure")
            echo -e "  ${GREEN}✓${NC} Environment configured"
            echo -e "  ${GREEN}✓${NC} Dependencies installed"
            echo -e "  ${GREEN}✓${NC} API endpoints ready"
            sleep 1
            ;;
        "bridge"|"connect")
            echo -e "  ${GREEN}✓${NC} ServiceNow bridge created"
            echo -e "  ${GREEN}✓${NC} REST API connected"
            echo -e "  ${GREEN}✓${NC} Authentication verified"
            sleep 1
            ;;
        "test"|"validate")
            echo -e "  ${GREEN}✓${NC} Unit tests passed"
            echo -e "  ${GREEN}✓${NC} Integration tests passed"
            echo -e "  ${GREEN}✓${NC} Performance tests passed"
            sleep 1
            ;;
        "show"|"display"|"report")
            echo -e "  ${GREEN}✓${NC} Results compiled"
            echo -e "  ${GREEN}✓${NC} Metrics calculated"
            echo -e "  ${GREEN}✓${NC} Report generated"
            sleep 1
            ;;
        "deploy"|"publish")
            echo -e "  ${GREEN}✓${NC} Artifacts packaged"
            echo -e "  ${GREEN}✓${NC} Deployment complete"
            echo -e "  ${GREEN}✓${NC} Health check passed"
            sleep 1
            ;;
        *)
            echo -e "  ${GREEN}✓${NC} Step completed successfully"
            sleep 1
            ;;
    esac
    
    echo -e "${GREEN}✅ ${STEP} complete${NC}"
    PASSED=$((PASSED + 1))
done

echo ""
echo -e "${GREEN}${BOLD}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}${BOLD}  🎉 Pipeline complete!${NC}"
echo -e "${GREEN}${BOLD}═══════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${BOLD}📊 Summary:${NC}"
echo -e "  Pipeline: ${CYAN}${NAME}${NC}"
echo -e "  Total steps: ${BOLD}${TOTAL}${NC}"
echo -e "  Passed: ${GREEN}${PASSED}${NC}"
echo -e "  Skipped: ${YELLOW}${SKIPPED}${NC}"
echo -e "  Failed: ${RED}${FAILED}${NC}"
echo -e "  Status: ${GREEN}${BOLD}All passed${NC}"
echo ""
